# Live Cursor cloud agents. When unset, the service stays in mock mode.
CURSOR_API_KEY=
# Default composer-2.5. Composer 2 is retired and rerouted by the SDK.
CURSOR_MODEL=composer-2.5

# Reads workflow jobs, logs, diffs, check status, and updates PR bodies.
GITHUB_TOKEN=
# When set, POST /webhook requires X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=

# Optional incident summary. When unset, a local template is used.
XAI_API_KEY=
XAI_MODEL=grok-4.7

PORT=8787
HOST=127.0.0.1
AUDIT_PATH=data/audit.jsonl
DEMO_REPO_URL=https://github.com/PSchmidt23/demo-commercial-app

# Force mock mode even if CURSOR_API_KEY is set.
DRY_RUN=

# Real-mode gate: how long to wait for the agent's commit to go green.
CI_POLL_ATTEMPTS=3
CI_POLL_INTERVAL_MS=4000

# Pause between scripted mock stream events so the dashboard can show motion.
MOCK_STREAM_DELAY_MS=40
